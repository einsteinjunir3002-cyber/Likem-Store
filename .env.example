# Database Connection
DATABASE_URL="postgresql://username:password@localhost:5432/likem_perfume?schema=public"

# Authentication
AUTH_SECRET="replace-with-a-random-32-character-secret-key"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# SEO: public production URL used for canonical URLs, sitemap.xml, robots.txt, Open Graph
# and structured data. Set to your final custom domain (no trailing slash) when you have one.
# If unset, NEXT_PUBLIC_APP_URL is used, then the Vercel alias from vercel.json.
NEXT_PUBLIC_SITE_URL="https://www.yourdomain.com"

# SEO: Google Search Console "HTML tag" verification. Paste ONLY the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Ghanaian Payment Provider - Paystack (MoMo & Card)
# Obtain from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Email Notifications (Optional - e.g. Resend)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=""
STORE_ALERT_EMAIL=""

# WhatsApp Business API (Optional future advanced integration)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
